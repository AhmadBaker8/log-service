# Port the service listens on inside its container.
# Must remain 8080 per the required API contract.
PORT=8080

# PostgreSQL connection string.
# Inside docker compose this points at the 'postgres' service by name.
DATABASE_URL=postgres://loguser:logpass@localhost:55432/logs

# --- Optional features: all OFF by default ---
# A bare `docker compose up` must yield the plain, unauthenticated
# core service. These exist only to enable extras explicitly.

# Master switch for authentication.
AUTH_ENABLED=false

# API key seeded at startup with full ingest and query permissions.
# Only used when AUTH_ENABLED=true.
LOADGEN_API_KEY=

# Retention window in days. Data older than this is removed.
RETENTION_DAYS=30
